rules_version = '2';

// Mr Laundry POS — Firestore security rules
// Cloud Sync data still uses the app's local login (not Firebase Auth) and lives under
//   shops/{shopId}              ← meta doc (chunked-v1)
//   shops/{shopId}/tables/{id}  ← per-table JSON / 800KB chunks
// The Google Drive Functions use Firebase Authentication separately. Their
// gdriveConnections collection is intentionally NOT granted to browser clients;
// Admin SDK access bypasses these rules.
// NOTE: the existing public shops-subtree rules are unchanged by the Drive backup work.
service cloud.firestore {
  match /databases/{database}/documents {

    match /shops/{shopId} {
      allow read, write: if true;

      match /tables/{tableId} {
        allow read, write: if true;
      }
    }

    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
